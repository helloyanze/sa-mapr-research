{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samapr.local/schema/executable-evidence-contract-v1.json",
  "title": "Executable Evidence Contract Schema v1.0",
  "type": "object",
  "required": [
    "contract_id",
    "bug_key",
    "static_evidence",
    "repair_obligations",
    "verification_obligations",
    "acceptance_criteria"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "bug_key": {
      "type": "string"
    },
    "static_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "pattern", "location"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "message": {"type": "string"},
          "priority": {"type": "string"},
          "rank": {"type": "string"},
          "location": {
            "type": "object",
            "required": ["file", "method"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "method": {"type": "string"},
              "start_line": {"type": "string"},
              "end_line": {"type": "string"}
            }
          }
        }
      }
    },
    "repair_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "checkability",
          "severity",
          "target",
          "failure_policy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "checkability": {
            "enum": [
              "M_AST",
              "M_TOOL",
              "L_ASSESS"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "metric_only"
            ]
          },
          "target": {
            "type": "object",
            "required": ["file", "method"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "method": {"type": "string"}
            }
          },
          "checker": {"type": "string"},
          "expected_ast_nodes": {"type": "array", "items": {"type": "string"}},
          "source_regex": {"type": "string"},
          "failure_policy": {
            "enum": [
              "reject",
              "log_only"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "verification_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "checkability", "checker", "severity", "failure_policy"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "checkability": {"enum": ["M_AST", "M_TOOL", "L_ASSESS"]},
          "checker": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocking", "metric_only"]},
          "failure_policy": {"enum": ["reject", "log_only"]}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
